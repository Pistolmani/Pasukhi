{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "https://api.pasukhi.ge",
    "Audience": "https://admin.pasukhi.ge",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Meta": {
    "AppId": "",
    "AppSecret": "",
    "OAuthRedirectUri": "https://pasukhi.com/login",
    "GraphBaseUrl": "https://graph.facebook.com",
    "GraphApiVersion": "v21.0"
  },
  "AI": {
    "Provider": "Gemini",
    "ApiKey": "",
    "Model": "gemini-2.0-flash-lite",
    "MaxTokens": 500,
    "Temperature": 0.3,
    "RequestTimeoutSeconds": 30,
    "ReasoningEffort": "low"
    // Provider options:
    // - "OpenAI": Model defaults to "gpt-5-mini"
    // - "Gemini" or "Google": Model defaults to "gemini-2.0-flash-lite" (free tier: 15 RPM, 1M tokens/day)
    //
    // Gemini setup:
    // 1. Get API key from https://aistudio.google.com/apikey
    // 2. Set Provider to "Gemini"
    // 3. Set ApiKey to your Gemini API key
    // 4. Optionally set Model to "gemini-2.0-flash" for smarter responses
  },
  "Cors": {
    "Origins": [
      "https://pasukhi.com",
      "https://www.pasukhi.com"
    ]
  },
  "AllowedHosts": "*",
  "BotReadiness": {
    "Sections": [
      {
        "Key": "business_basics",
        "Label": "Business basics",
        "Description": "Core facts the bot should know before answering customers.",
        "Questions": [
          {
            "Key": "business_summary",
            "Label": "What does the business sell or provide?",
            "HelpText": "Write a short description customers would understand.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          },
          {
            "Key": "customer_languages",
            "Label": "Which languages should the bot support?",
            "HelpText": "Example: Georgian, English, Russian.",
            "InputType": "text",
            "Required": true,
            "Weight": 1
          },
          {
            "Key": "contact_policy",
            "Label": "When should customers contact a human?",
            "HelpText": "Mention phone calls, complex orders, complaints, or urgent cases.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 2
          }
        ]
      },
      {
        "Key": "products_services",
        "Label": "Products and services",
        "Description": "What customers usually ask about before ordering.",
        "Questions": [
          {
            "Key": "top_products",
            "Label": "What are the main products or services?",
            "HelpText": "List the most common items customers ask for.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          },
          {
            "Key": "price_range",
            "Label": "What prices or price ranges can the bot mention?",
            "HelpText": "If prices vary, explain what affects the price.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          }
        ]
      },
      {
        "Key": "custom_orders",
        "Label": "Custom orders",
        "Description": "Rules for individual/custom work.",
        "Questions": [
          {
            "Key": "custom_order_policy",
            "Label": "Do you accept custom or individual orders?",
            "HelpText": "Include what information the customer must send.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          }
        ]
      },
      {
        "Key": "delivery_pickup",
        "Label": "Delivery and pickup",
        "Description": "How customers receive orders.",
        "Questions": [
          {
            "Key": "delivery_policy",
            "Label": "What are the delivery areas, prices, and timing?",
            "HelpText": "Mention Tbilisi/regions, courier, pickup, and timing.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          },
          {
            "Key": "pickup_policy",
            "Label": "Can customers pick up orders?",
            "HelpText": "Mention address or that pickup is not available.",
            "InputType": "textarea",
            "Required": false,
            "Weight": 1
          }
        ]
      },
      {
        "Key": "payment_returns",
        "Label": "Payment and returns",
        "Description": "Policies that should never be guessed by AI.",
        "Questions": [
          {
            "Key": "payment_methods",
            "Label": "Which payment methods do you accept?",
            "HelpText": "Example: cash, card, bank transfer, deposit.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          },
          {
            "Key": "return_policy",
            "Label": "What is your return or exchange policy?",
            "HelpText": "Include custom-order exceptions if relevant.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          }
        ]
      },
      {
        "Key": "production_tone",
        "Label": "Production and tone",
        "Description": "Timing and voice for automated replies.",
        "Questions": [
          {
            "Key": "production_time",
            "Label": "How long does production or preparation take?",
            "HelpText": "Mention normal timing and rush-order limits.",
            "InputType": "textarea",
            "Required": true,
            "Weight": 3
          },
          {
            "Key": "tone_preference",
            "Label": "What tone should the bot use?",
            "HelpText": "Example: warm, short, polite, emoji-light.",
            "InputType": "text",
            "Required": true,
            "Weight": 1
          }
        ]
      }
    ]
  }
}
